# --- App ---
NEXT_PUBLIC_APP_NAME=Proofolio
PUBLIC_BASE_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/mcp

# --- Supabase (local: `npx supabase start` prints these) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server/worker only, never NEXT_PUBLIC_
DATABASE_URL=                       # worker direct Postgres connection

# --- Model provider: Nebius Token Factory + NVIDIA Nemotron (server only) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=                       # pick from `npm run nebius:models`, e.g. a Nemotron model ID

# --- Limits and flags ---
AI_GENERATION_ENABLED=true
MCP_ENABLED=true
PUBLIC_SIGNUP_ENABLED=true
PUBLIC_PUBLISH_ENABLED=true
GLOBAL_DAILY_GENERATION_CAP=200
USER_DAILY_GENERATION_CAP=5

# --- Support (real owner-provided contact required before launch) ---
SUPPORT_CONTACT=
